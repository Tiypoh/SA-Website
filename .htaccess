RewriteEngine on
ErrorDocument 404 /resources/404.html

RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://sebringautomotive.shop/$1 [R]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R]

RewriteRule ^home$ / [R=301]
RewriteRule ^cars/$ /cars/shopcars [R]
RewriteRule ^blog/$ /blog/blogposts [NC]
RewriteRule ^/versions/v1.0.0/home.html$ /versions/v1.0.0/index.html
RewriteRule ^/versions/v1.0.1/home.html$ /versions/v1.0.1/index.html
RewriteRule ^/versions/v1.0.2/index.html$ /versions/v1.0.2/home.html
RewriteRule ^/versions/v1.0.3/index.html$ /versions/v1.0.3/home.html
RewriteRule ^/versions/v1.1.0/index.html$ /versions/v1.1.0/home.html
RewriteRule ^/versions/v1.1.1/index.html$ /versions/v1.1.1/home.html
RewriteRule ^/versions/v1.1.2/index.html$ /versions/v1.1.2/home.html
RewriteRule ^/versions/v1.1.3/home.html$ /versions/v1.1.3/index.html
RewriteRule ^/versions/v1.2.0/home.html$ /versions/v1.2.0/index.html
RewriteRule ^/versions/v1.2.1/home.html$ /versions/v1.2.1/index.html
RewriteRule ^/versions/v1.2.2/home.html$ /versions/v1.2.2/index.html
RewriteRule ^/versions/v1.2.3/home.html$ /versions/v1.2.3/index.html


RewriteRule ^services$ /services/ourservices [R=301]
RewriteRule ^projects$ /cars/shopcars [R=301]

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [L]